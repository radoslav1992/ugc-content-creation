# Media / premium voice integrations (independent credentials and configuration).
MEDIA_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICES=
STUDIO_SCRIPT_MODEL=openai/gpt-5.6-luna
WAVESPEED_API_KEY=
