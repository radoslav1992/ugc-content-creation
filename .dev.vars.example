# Copy to .dev.vars for LOCAL DEVELOPMENT ONLY. Never commit .dev.vars.
APP_ENV=development
SITE_URL=http://localhost:8787
REGISTRATION_ENABLED=false
BILLING_ENABLED=false
# Public operator information must be accurate before opening registrations.
